POSTGRES_PASSWORD = enter_your_postgres_password
POSTGRES_DB = enter_your_postgres_database_name
COMMUNICATION_URL=http://communication:8000
SEAWEEDFS_FILER_URL=http://seaweedfs:8888
SEAWEEDFS_VOLUME_URL=http://seaweedfs:8080
NATS_PORT=4222
