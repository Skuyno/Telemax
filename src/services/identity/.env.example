POSTGRES_USER = enter_your_postgres_username
POSTGRES_PASSWORD = enter_your_postgres_password
POSTGRES_DB = enter_your_postgres_database_name
JWT_SECRET = enter_your_jwt
ALLOW_REGISTRATION=true
# Автосоздаваемый superuser-аккаунт — сменить перед реальным деплоем
SUPERUSER_USERNAME=admin
SUPERUSER_PASSWORD=admin
# Логирование SQL-запросов SQLAlchemy (со значениями параметров) — только для локальной отладки
SQL_ECHO=false